## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
bin/
obj/

# SQLite database
*.db
*.db-shm
*.db-wal

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docview

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code
.vscode/

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
